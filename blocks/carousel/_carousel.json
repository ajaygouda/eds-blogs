{
  "definitions": [
    {
      "id": "carousel",
      "title": "Carousel",
      "category": "Layout",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "container": true,
            "template": {
              "name": "Carousel",
              "model": "carousel",
              "filter": "carousel-filter",
              "structure": {
                "element": "div",
                "classes": ["carousel"],
                "children": [
                  { "element": "h2", "binding": "title" },
                  {
                    "element": "div",
                    "classes": ["carousel-items"],
                    "repeat": "carousel-item",
                    "children": [
                      {
                        "element": "div",
                        "classes": ["carousel-slide"],
                        "children": [
                          { "element": "img", "binding": "image" },
                          { "element": "h3", "binding": "title" },
                          { "element": "p", "binding": "description" },
                          {
                            "element": "a",
                            "classes": ["button"],
                            "binding": "link",
                            "textContent": "ctaText"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "id": "carousel-item",
      "title": "Carousel Item",
      "category": "Layout",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Carousel Item",
              "model": "carousel-item"
            }
          }
        }
      }
    }
  ],
  "models": {
    "carousel": {
      "fields": [
        {
          "component": "text",
          "name": "title",
          "label": "Carousel Title",
          "valueType": "string"
        },
        {
          "component": "multiselect",
          "name": "style",
          "label": "Style Variant",
          "options": [
            { "name": "Default", "value": "default" },
            { "name": "Minimal", "value": "minimal" }
          ]
        }
      ]
    },
    "carousel-item": {
      "fields": [
        {
          "component": "text",
          "name": "title",
          "label": "Slide Title",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "description",
          "label": "Slide Description",
          "valueType": "string"
        },
        {
          "component": "reference",
          "name": "image",
          "label": "Slide Image",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "ctaText",
          "label": "Button Text",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "link",
          "label": "Button Link URL",
          "valueType": "string"
        }
      ]
    }
  },
  "filters": {
    "carousel-filter": {
      "components": ["carousel-item"]
    }
  }
}
